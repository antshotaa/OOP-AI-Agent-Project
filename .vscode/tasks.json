
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build entire project",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/utf-8",
                "/I",
                "C:/vcpkg/installed/x64-windows/include",
                "/I",
                "${workspaceFolder}/Agent_25120015/src",
                "/Fo${workspaceFolder}/Agent_25120015/build/",
                "/Fd${workspaceFolder}/Agent_25120015/build/vc140.pdb",
                "/Fe${workspaceFolder}/Agent_25120015/build/OllamaTest.exe",
                "${workspaceFolder}/Agent_25120015/src/main.cpp",
                "${workspaceFolder}/Agent_25120015/src/client/ollama_client.cpp",
                "${workspaceFolder}/Agent_25120015/src/tools/tool_registry.cpp",
                "${workspaceFolder}/Agent_25120015/src/tools/calc_tool.cpp",
                "/link",
                "/LIBPATH:C:/vcpkg/installed/x64-windows/lib",
                "libcurl.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Agent_25120015"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
